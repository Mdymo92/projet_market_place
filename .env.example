# Copy to .env and change every value. .env is git-ignored: never commit it.

# --- PostgreSQL (superuser, used only by init scripts) ---
POSTGRES_USER=market_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=market

# One PostgreSQL role per service (volet 1: a service never reads another schema)
AUTH_DB_PASSWORD=change-me-auth
ORDERS_DB_PASSWORD=change-me-orders
INVENTORY_DB_PASSWORD=change-me-inventory
PAYMENTS_DB_PASSWORD=change-me-payments
ANALYTICS_DB_PASSWORD=change-me-analytics

# --- MongoDB ---
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change-me-mongo
CATALOG_DB_PASSWORD=change-me-catalog

# --- MinIO (S3) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-123

# --- Auth ---
# Shared HS256 key: signed by the auth service, verified by Kong and every service
JWT_SECRET=change-me-to-a-long-random-string-of-64-chars-minimum-please
JWT_ISSUER=market-auth
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Service accounts (service-to-service calls, role service_account)
ORDERS_SERVICE_API_KEY=change-me-orders-key

# Test users created by scripts/seed_users.py (one per RBAC role)
SEED_ADMIN_PASSWORD=change-me-admin-user
SEED_CATALOG_MANAGER_PASSWORD=change-me-catalog-user
SEED_ANALYST_PASSWORD=change-me-analyst-user
SEED_LOGISTICS_PASSWORD=change-me-logistics-user

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
